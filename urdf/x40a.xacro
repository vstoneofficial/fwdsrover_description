<?xml version="1.0"?>
<robot name="x40a" xmlns:xacro="http://www.ros.org/wiki/xacro">

   <xacro:include filename="$(find fwdsrover_description)/urdf/materials.xacro"/>
   <xacro:include filename="$(find fwdsrover_description)/urdf/x40a.gazebo"/>
   <xacro:include filename="$(find fwdsrover_description)/urdf/x40a.ros2_control.xacro"/>
 
  <!-- OPTION LRF TG30 -->
   <xacro:include filename="$(find vs_rover_options_description)/urdf/lrf/tg30_x40a.xacro" />

  <!-- OPTION bumper sensor -->
   <!-- <xacro:include filename="$(find vs_rover_options_description)/urdf/bumper/bumper_x40a.xacro" />
   <xacro:bumperbaseboard prefix="front" parent="base_link" xyz="0 0.20515 0.038" z_dir="180" />
   <xacro:bumperbaseboard prefix="back" parent="base_link" xyz="0 -0.20515 0.038" z_dir="0" />
   <xacro:bumperbaseboard prefix="left" parent="base_link" xyz="0.20515 0 0.038" z_dir="90" />
   <xacro:bumperbaseboard prefix="right" parent="base_link" xyz="-0.20515 0 0.038" z_dir="270" />-->

  <!-- OPTION camera stay -->
   <!-- <xacro:include filename="$(find vs_rover_options_description)/urdf/cam_stay/cam_stay_x40a.xacro" />-->

  <!-- OPTION Intel Realsense depth camera D435i (camera stay required) -->
   <!--<xacro:include filename="$(find vs_rover_options_description)/urdf/depth_cam/_d435i.urdf.xacro" />
   <xacro:sensor_d435i parent="cam_mount_link" use_nominal_extrinsics="true">
   <origin xyz="0.0295 0 0.0095" rpy="0 0 0" />
   </xacro:sensor_d435i>-->

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.000058 0.002054 0.132327" rpy="0 0 0"/>
      <mass value="23.5"/>
      <inertia ixx="2.646709e-01" ixy="2.711956e-03" ixz="4.327639e-05"
               iyy="2.696116e-01" iyz="-1.577241e-03"
               izz="4.399520e-01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fwdsrover_description/meshes/x40a/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fwdsrover_description/meshes/x40a/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 ${radians(-90)}"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ================================================= -->
  <!-- Auto inertia macros (solid primitives, COM at geometry origin) -->
  <!-- ================================================= -->

  <!-- Solid cylinder inertia (axis Z), about COM -->
  <xacro:macro name="inertia_cylinder" params="m r h">
    <xacro:property name="Izz" value="${0.5 * m * r * r}"/>
    <xacro:property name="Ixx" value="${(1.0/12.0) * m * (3*r*r + h*h)}"/>
    <inertia ixx="${Ixx}" ixy="0" ixz="0"
             iyy="${Ixx}" iyz="0"
             izz="${Izz}"/>
  </xacro:macro>

  <!-- Solid box inertia, about COM -->
  <xacro:macro name="inertia_box" params="m x y z">
    <inertia
      ixx="${(1.0/12.0) * m * (y*y + z*z)}"
      ixy="0" ixz="0"
      iyy="${(1.0/12.0) * m * (x*x + z*z)}"
      iyz="0"
      izz="${(1.0/12.0) * m * (x*x + y*y)}"/>
  </xacro:macro>

  <!-- ================================================= -->
  <!-- Link macros (collision-driven inertia + COM origin = collision origin) -->
  <!-- ================================================= -->

  <!-- Joint link collision cylinder -->
  <xacro:macro name="joint_link" params="name m r h col_xyz col_rpy">
    <link name="${name}">
      <inertial>
        <!-- COM assumed at collision primitive center -->
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <mass value="${m}"/>
        <xacro:inertia_cylinder m="${m}" r="${r}" h="${h}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://fwdsrover_description/meshes/x40a/joint.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <geometry>
          <cylinder radius="${r}" length="${h}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Suspension link collision box -->
  <xacro:macro name="sus_link" params="name m sx sy sz col_xyz col_rpy">
    <link name="${name}">
      <inertial>
        <!-- COM assumed at collision primitive center -->
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <mass value="${m}"/>
        <xacro:inertia_box m="${m}" x="${sx}" y="${sy}" z="${sz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://fwdsrover_description/meshes/x40a/sus.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Wheel link collision cylinder -->
  <xacro:macro name="wheel_link" params="name m r h col_xyz col_rpy">
    <link name="${name}">
      <inertial>
        <!-- COM assumed at collision primitive center -->
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <mass value="${m}"/>
        <xacro:inertia_cylinder m="${m}" r="${r}" h="${h}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://fwdsrover_description/meshes/x40a/wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="${col_xyz}" rpy="${col_rpy}"/>
        <geometry>
          <cylinder radius="${r}" length="${h}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- ================================================= -->
  <!-- Joint macros -->
  <!-- ================================================= -->

  <xacro:macro name="steering_joint" params="name parent child xyz rpy effort velocity damping friction has_dynamics">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <limit lower="-3.14159" upper="3.14159" effort="${effort}" velocity="${velocity}"/>
      <xacro:if value="${has_dynamics}">
        <dynamics damping="${damping}" friction="${friction}"/>
      </xacro:if>
    </joint>
  </xacro:macro>

  <xacro:macro name="sus_joint" params="name parent child xyz rpy damping friction">
    <joint name="${name}" type="prismatic">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <limit lower="0.0" upper="0.015" effort="300" velocity="1.0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="name parent child xyz rpy axis_z">
    <joint name="${name}" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 ${axis_z}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <limit effort="500" velocity="50000"/>
      <dynamics damping="0.02"/>
    </joint>
  </xacro:macro>

  <!-- ================================================= -->
  <!-- Wheel unit macro (naming rule centralized) -->
  <!-- ================================================= -->

  <xacro:macro name="wheel_unit"
               params="prefix
                       steering_xyz steering_rpy steering_has_dyn
                       steering_damping steering_friction
                       sus_xyz sus_rpy
                       wheel_xyz wheel_rpy
                       wheel_axis_z">

    <!-- constants from original model -->
    <xacro:property name="joint_m" value="0.1"/>
    <xacro:property name="joint_r" value="0.0525"/>
    <xacro:property name="joint_h" value="0.02"/>
    <xacro:property name="joint_col_xyz" value="0 0 -0.01"/>
    <xacro:property name="joint_col_rpy" value="0 0 0"/>

    <xacro:property name="sus_m" value="0.1"/>
    <xacro:property name="sus_sx" value="0.025"/>
    <xacro:property name="sus_sy" value="0.046"/>
    <xacro:property name="sus_sz" value="0.05"/>
    <xacro:property name="sus_col_xyz" value="0 0 -0.025"/>
    <xacro:property name="sus_col_rpy" value="0 0 0"/>

    <xacro:property name="wheel_m" value="1.239858"/>
    <xacro:property name="wheel_r" value="0.07"/>
    <xacro:property name="wheel_h" value="0.0435"/>
    <xacro:property name="wheel_col_xyz" value="0 0 0.0295"/>
    <xacro:property name="wheel_col_rpy" value="0 0 0"/>

    <!-- Links (names derived from prefix) -->
    <xacro:joint_link name="${prefix}_joint_1"
                      m="${joint_m}" r="${joint_r}" h="${joint_h}"
                      col_xyz="${joint_col_xyz}" col_rpy="${joint_col_rpy}"/>

    <xacro:sus_link name="${prefix}_sus_1"
                    m="${sus_m}" sx="${sus_sx}" sy="${sus_sy}" sz="${sus_sz}"
                    col_xyz="${sus_col_xyz}" col_rpy="${sus_col_rpy}"/>

    <xacro:wheel_link name="${prefix}_wheel_1"
                      m="${wheel_m}" r="${wheel_r}" h="${wheel_h}"
                      col_xyz="${wheel_col_xyz}" col_rpy="${wheel_col_rpy}"/>

    <!-- Steering joint -->
    <xacro:steering_joint
      name="${prefix}_steering_joint"
      parent="base_link"
      child="${prefix}_joint_1"
      xyz="${steering_xyz}"
      rpy="${steering_rpy}"
      effort="1000.0"
      velocity="1.0"
      damping="${steering_damping}"
      friction="${steering_friction}"
      has_dynamics="${steering_has_dyn}"/>

    <!-- Suspension joint -->
    <xacro:sus_joint
      name="${prefix}_sus_joint"
      parent="${prefix}_joint_1"
      child="${prefix}_sus_1"
      xyz="${sus_xyz}"
      rpy="${sus_rpy}"
      damping="300"
      friction="0"/>

    <!-- Wheel joint -->
    <xacro:wheel_joint
      name="${prefix}_wheel_joint"
      parent="${prefix}_sus_1"
      child="${prefix}_wheel_1"
      xyz="${wheel_xyz}"
      rpy="${wheel_rpy}"
      axis_z="${wheel_axis_z}"/>

  </xacro:macro>

  <!-- ================================================= -->
  <!-- Wheel instances -->
  <!-- ================================================= -->

  <!-- steering damping/friction present in original for FL/FR/BR, absent for BL -->
  <!-- sus xyz="0.0 -0.042 -0.0605", rpy="0 0 -90deg" -->
  <!-- wheel xyz="-0.0141 0 -0.031", rpy="0 -90deg 0" -->

  <xacro:wheel_unit
    prefix="front_left"
    steering_xyz="-0.125 0.125 0.16"
    steering_rpy="0 0 ${radians(90)}"
    steering_has_dyn="true"
    steering_damping="100.0"
    steering_friction="0.1"
    sus_xyz="0.0 -0.042 -0.0605"
    sus_rpy="0 0 ${radians(-90)}"
    wheel_xyz="-0.0141 0.0 -0.031"
    wheel_rpy="0 ${radians(-90)} 0"
    wheel_axis_z="1"/>

  <xacro:wheel_unit
    prefix="front_right"
    steering_xyz="0.125 0.125 0.16"
    steering_rpy="0 0 ${radians(-90)}"
    steering_has_dyn="true"
    steering_damping="100.0"
    steering_friction="0.1"
    sus_xyz="0.0 -0.042 -0.0605"
    sus_rpy="0 0 ${radians(-90)}"
    wheel_xyz="-0.0141 0.0 -0.031"
    wheel_rpy="0 ${radians(-90)} 0"
    wheel_axis_z="-1"/>

  <xacro:wheel_unit
    prefix="back_right"
    steering_xyz="0.125 -0.125 0.16"
    steering_rpy="0 0 ${radians(-90)}"
    steering_has_dyn="true"
    steering_damping="100.0"
    steering_friction="0.1"
    sus_xyz="0.0 -0.042 -0.0605"
    sus_rpy="0 0 ${radians(-90)}"
    wheel_xyz="-0.0141 0.0 -0.031"
    wheel_rpy="0 ${radians(-90)} 0"
    wheel_axis_z="-1"/>

  <xacro:wheel_unit
    prefix="back_left"
    steering_xyz="-0.125 -0.125 0.16"
    steering_rpy="0 0 ${radians(90)}"
    steering_has_dyn="false"
    steering_damping="0"
    steering_friction="0"
    sus_xyz="0.0 -0.042 -0.0605"
    sus_rpy="0 0 ${radians(-90)}"
    wheel_xyz="-0.0141 0.0 -0.031"
    wheel_rpy="0 ${radians(-90)} 0"
    wheel_axis_z="1"/>

</robot>

